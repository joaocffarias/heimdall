# ============================================
# Heimdall — Variáveis de Ambiente
# Copie para .env e configure antes de subir
# ============================================

# ---- PostgreSQL ----
POSTGRES_USER=heimdall
POSTGRES_PASSWORD=heimdall_secret_2025
POSTGRES_DB=heimdall_db
DATABASE_URL=postgresql://heimdall:heimdall_secret_2025@postgres:5432/heimdall_db

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- MinIO Object Storage ----
MINIO_ROOT_USER=heimdall_minio
MINIO_ROOT_PASSWORD=minio_secret_2025
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=heimdall
MINIO_PUBLIC_URL=http://192.168.18.223:9000

# ---- JWT Auth ----
JWT_SECRET=heimdall_jwt_super_secret_troque_em_producao_2025
JWT_EXPIRES_IN=7d
SIGNATURE_TOKEN_EXPIRES_HOURS=48

# ---- URLs do App ----
API_URL=http://api:4000
WEB_URL=http://192.168.18.223:3000
API_PUBLIC_URL=http://192.168.18.223:4000

# ---- E-mail (SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app_gmail
SMTP_FROM="Heimdall <noreply@heimdall.local>"

# ---- WhatsApp (Evolution API) ----
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=heimdall_evolution_key_2025
EVOLUTION_INSTANCE=heimdall

# ---- SMS (Twilio - opcional) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- LDAP Auth ----
LDAP_ENABLED=false
LDAP_URL=ldap://192.168.1.100:389
LDAP_SEARCH_BASE=dc=fab,dc=mil,dc=br
LDAP_SEARCH_FILTER=(mail={{username}})
LDAP_BIND_DN=cn=admin,dc=fab,dc=mil,dc=br
LDAP_BIND_CREDENTIALS=secret

# ---- Geral ----
NODE_ENV=production
PORT=4000
TZ=America/Belem
